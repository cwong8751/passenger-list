# Required: random string, 16+ chars. Used to pepper PIN hashes, encrypt pickup codes, and sign sessions.
# Changing it invalidates all PINs and sessions. Generate: openssl rand -hex 32
APP_SECRET=

# First administrator, created automatically if no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Production database (Turso / libSQL). Leave unset locally to use data/app.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
